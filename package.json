{
  "name": "bytehoven",
  "version": "0.1.0",
  "description": "An animated orchestra for your AI coding agents — hear what they are doing.",
  "bin": {
    "bytehoven": "cli/cli.js"
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:cli",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "prepare-samples": "node scripts/prepare-samples.mjs",
    "test": "node --test tests/*.test.ts",
    "hooks": "node bin/hooks.ts",
    "build:cli": "vite build -c vite.cli.config.ts && vite build -c vite.cli.config.ts --mode hook",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^24.19.2",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "tone": "^15.1.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": false,
  "keywords": [
    "claude-code",
    "ai-agents",
    "sonification",
    "visualizer",
    "orchestra",
    "pixel-art",
    "pixijs",
    "tonejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkinozturk/bytehoven.git"
  },
  "homepage": "https://github.com/berkinozturk/bytehoven#readme"
}
